"""BD Rhapsody FASTQ preparation, native SimpleAF USA and H5AD."""
import os
import os.path as op
import re
import hashlib
import json
import shlex
import subprocess
import sys

configfile: op.join(workflow.basedir, '..', 'configs', 'velocity.yaml')

_repo_root = op.abspath(op.join(workflow.basedir, '..'))
config['working_dir'] = config.get('working_dir', 'results')
if not op.isabs(config['working_dir']):
    config['working_dir'] = op.join(_repo_root, config['working_dir'])
config.setdefault('nthreads', 16)
config.setdefault('downsample', 100)
config.setdefault('cb_umi_max_errors', 0)

include: 'src/required_helpers.py'

if config.get('bead_chemistry', 'enhanced_v2') not in ('enhanced_v2', 'enhanced_v3'):
    raise ValueError('Velocity conversion supports Enhanced V2/V3 with 384-entry panels only')
if config['simpleaf'].get('resolution', 'usa') != 'usa':
    raise ValueError('This companion requires USA output')
if config['nthreads'] < 2:
    raise ValueError('nthreads must be at least 2 for SimpleAF')
if not get_sample_names() or len(set(get_sample_names())) != len(get_sample_names()):
    raise ValueError('Sample names must be nonempty and unique')
for sample in config['samples']:
    name = sample['name']
    if not isinstance(name, str) or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]*', name):
        raise ValueError('Sample names must be safe path components')
    uses = sample['uses']
    if not uses.get('cb_umi_fq') or not uses.get('cdna_fq') or uses.get('sra_run'):
        raise ValueError('Supply local raw paired FASTQs through uses.cb_umi_fq and uses.cdna_fq')
    if str(uses.get('allowedlist', 384)) != '384' or get_bead_type_by_name(name) != 'enhanced_v2':
        raise ValueError('Enhanced V2/V3 requires allowedlist: 384 and diversity_insets: yes')
    get_downsample_fraction(name)
validate_fastq_lists()

shell.prefix('set -euo pipefail; ')

WORK = config['working_dir']
SCRIPTS = op.join(workflow.basedir, 'scripts')
PANELS = op.join(workflow.basedir, 'data', 'whitelist_384x3')
PROVENANCE = op.join(workflow.basedir, 'data', 'velocity_provenance.json')
sys.path.insert(0, SCRIPTS)
from simpleaf_quant import index_directory, WORKFLOW_SOURCES
QUANT = op.join(WORK, '{sample}', 'simpleaf')
QC = op.join(WORK, '{sample}', 'qc')
H5AD = op.join(WORK, '{sample}', '{sample}_velocity.h5ad')
R1 = op.join(WORK, 'data', 'fastq', '{sample}_standardized_cb_umi.fq.gz')
R2 = op.join(WORK, 'data', 'fastq', '{sample}_standardized_cdna.fq.gz')
WHITELIST = op.join(WORK, 'data', '{sample}_observed_whitelist.txt')
REF = config['simpleaf']['index'].rstrip('/')
INDEX = str(index_directory(REF))
REFERENCE_CHECK = op.join(WORK, 'qc', 'reference_validation.json')
UNIT_ROOT = op.join(WORK, 'data', 'fastq', 'units', '{sample}')
UNIT_R1 = op.join(UNIT_ROOT, '{unit}_R1.fq.gz')
UNIT_R2 = op.join(UNIT_ROOT, '{unit}_R2.fq.gz')
UNIT_STATS = op.join(WORK, 'logs', '{sample}_unit_{unit}.json')
REFERENCE_MANIFEST = config['simpleaf'].get('reference_manifest')
if REFERENCE_MANIFEST is None and op.isfile(op.join(INDEX, 'reference_manifest.json')):
    REFERENCE_MANIFEST = op.join(INDEX, 'reference_manifest.json')


def preparation_units(sample):
    return (['downsampled'] if get_downsample_fraction(sample) < 1.0
            else [f'{i:04d}' for i in range(len(get_cbumi_inputs(sample)))])


def preparation_inputs(sample, mate):
    if get_downsample_fraction(sample) < 1.0:
        return [get_cbumi_by_name(sample) if mate == 1 else get_cdna_by_name(sample)]
    return get_cbumi_inputs(sample) if mate == 1 else get_cdna_inputs(sample)



rule all:
    input:
        expand(H5AD, sample=get_sample_names()),
        expand(op.join(QC, 'validation_summary.tsv'), sample=get_sample_names())

rule validate_reference:
    input:
        index_meta=op.join(INDEX, 'simpleaf_index.json'),
        index_files=expand(op.join(INDEX, 'piscem_idx.{suffix}'), suffix=['ctab', 'refinfo', 'ssi']),
        t2g=op.join(INDEX, 't2g_3col.tsv'),
        manifest=[REFERENCE_MANIFEST] if REFERENCE_MANIFEST else [],
        script=op.join(SCRIPTS, 'simpleaf_quant.py')
    output:
        REFERENCE_CHECK
    params:
        reference=REF
    resources:
        mem_mb=512
    message: 'Validate reference content and declared identity before FASTQ preparation'
    run:
        from simpleaf_quant import inspect_reference
        import json
        data = inspect_reference(params.reference, input.manifest[0] if input.manifest else None)
        with open(output[0], 'w') as handle:
            json.dump(data, handle, indent=2)


include: 'src/prepare_fastq.snmk'

rule fastq_qc:
    input:
        r1=R1, r2=R2, whitelist=WHITELIST,
        raw1=lambda wc: get_cbumi_inputs(wc.sample),
        raw2=lambda wc: get_cdna_inputs(wc.sample),
        receipt=op.join(QC, 'preparation_qc.json'),
        panels=expand(op.join(PANELS, 'BD_CLS{part}.txt'), part=[1,2,3]),
        stats=op.join(WORK, 'logs', 'standardize_cb_umis_{sample}.json'),
        chemistry=op.join(WORK, 'logs', '{sample}_bead_version_validated.flag'),
        script=op.join(SCRIPTS, 'simpleaf_quant.py')
    output:
        report=op.join(QC, 'fastq_qc.tsv')
    params:
        exhaustive=config.get('fastq_qc_exhaustive', False)
    resources:
        mem_mb=config.get('fastq_qc_mem_mb', 4096)
    message: 'Check FASTQ validation receipt for {wildcards.sample}'
    log:
        op.join(WORK, 'logs', '{sample}_fastq_qc.log')
    run:
        import importlib.util
        spec = importlib.util.spec_from_file_location('quant_interface', input.script)
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        if open(input.chemistry).read().strip() != 'enhanced':
            raise ValueError('Expected Enhanced linkers; inspect upstream bead validation log')
        module.fastq_qc(input.raw1, input.raw2, input.r1, input.r2, input.whitelist, output.report,
                        receipt=input.receipt, sample=wildcards.sample, panels=input.panels,
                        cutadapt_json=input.stats, exhaustive=params.exhaustive)
        with open(log[0], 'w') as handle:
            mode = 'independent full mate scan' if params.exhaustive else 'receipt; prepared pairing by construction'
            handle.write(f'PASS: {mode}; 27nt barcode + 8nt UMI geometry; whitelist\n')

rule simpleaf_quant:
    input:
        r1=R1, r2=R2, whitelist=WHITELIST,
        receipt=op.join(QC, 'preparation_qc.json'),
        workflow_sources=list(map(str, WORKFLOW_SOURCES)),
        lock=op.join(_repo_root, 'pixi.lock'),
        qc=op.join(QC, 'fastq_qc.tsv'),
        index_meta=op.join(INDEX, 'simpleaf_index.json'),
        index_files=expand(op.join(INDEX, 'piscem_idx.{suffix}'), suffix=['ctab', 'refinfo', 'ssi']),
        t2g=op.join(INDEX, 't2g_3col.tsv'),
        provenance=PROVENANCE,
        reference_check=REFERENCE_CHECK,
        script=op.join(SCRIPTS, 'simpleaf_quant.py')
    output:
        quant=directory(QUANT)
    params:
        settings=config['simpleaf'],
        config_sha256=hashlib.sha256(json.dumps(config, sort_keys=True, separators=(',', ':'),
                                              allow_nan=False).encode()).hexdigest()
    threads: config['nthreads']
    resources:
        mem_mb=config.get('max_mem_mb', 64000)
    log:
        op.join(WORK, 'logs', '{sample}_simpleaf.log')
    run:
        subprocess.run([sys.executable, input.script,
                        '--reference', params.settings['index'], '--r1', input.r1, '--r2', input.r2,
                        '--whitelist', input.whitelist, '--output', output.quant,
                        '--threads', str(threads), '--log', log[0],
                        '--upstream-provenance', input.provenance,
                        '--reference-validation', input.reference_check,
                        '--config-sha256', params.config_sha256,
                        '--preparation-qc', input.receipt], check=True)

rule export_h5ad:
    input:
        quant=QUANT,
        panels=expand(op.join(PANELS, 'BD_CLS{part}.txt'), part=[1,2,3]),
        scripts=[op.join(SCRIPTS, p) for p in ['export_velocity.py', 'bd_barcode_conversion.py', 'velocity_common.py']],
        reference=lambda wc: [s['uses']['bd_reference'] for s in config['samples']
                              if s['name'] == wc.sample and s['uses'].get('bd_reference')
                              and op.isfile(s['uses']['bd_reference'])],
        gene_map=lambda wc: ([op.join(INDEX, 'gene_id_to_name.tsv')]
                             if op.isfile(op.join(INDEX, 'gene_id_to_name.tsv')) else [])
    output:
        h5ad=H5AD,
        quant_summary=op.join(QC, 'quantification_summary.tsv'),
        conversion=op.join(QC, 'barcode_conversion.tsv'),
        differences=op.join(QC, 'bd_reference_differences.tsv')
    params:
        python=config['export']['python'],
        script=op.join(SCRIPTS, 'export_velocity.py'),
        qc=QC,
        panels=PANELS,
        quant=op.join(QUANT, 'af_quant'),
        provenance=op.join(QUANT, 'pipeline_provenance.json'),
        reference=lambda wc, input: ('--bd-reference ' + shlex.quote(input.reference[0])
                                     if input.reference else ''),
        gene_map=lambda wc, input: ('--gene-map ' + shlex.quote(input.gene_map[0])
                                    if input.gene_map else '')
    threads: 1
    resources:
        mem_mb=config.get('export_mem_mb', 16000)
    log:
        op.join(WORK, 'logs', '{sample}_export_h5ad.log')
    shell:
        '{params.python:q} {params.script:q} --quant {params.quant:q} '
        '--output {output.h5ad:q} --sample {wildcards.sample:q} '
        '--qc {params.qc:q} --keys {params.panels:q} --provenance {params.provenance:q} '
        '{params.reference} {params.gene_map} > {log:q} 2>&1'

rule validate_outputs:
    input:
        h5ad=H5AD,
        quant=QUANT,
        scripts=[op.join(SCRIPTS, p) for p in ['validate_velocity.py', 'bd_barcode_conversion.py', 'velocity_common.py']],
        panels=expand(op.join(PANELS, 'BD_CLS{part}.txt'), part=[1,2,3])
    output:
        op.join(QC, 'validation_summary.tsv')
    params:
        python=config['export']['python'],
        script=op.join(SCRIPTS, 'validate_velocity.py'),
        panels=PANELS,
        quant=op.join(QUANT, 'af_quant')
    threads: 1
    resources:
        mem_mb=config.get('export_mem_mb', 16000)
    log:
        op.join(WORK, 'logs', '{sample}_validate_outputs.log')
    shell:
        '{params.python:q} {params.script:q} --input {input.h5ad:q} '
        '--quant {params.quant:q} '
        '--keys {params.panels:q} --output {output:q} > {log:q} 2>&1'
