rule concat_fastqs:
    input:
        r1 = lambda wildcards: get_cbumi_inputs(wildcards.sample),
        r2 = lambda wildcards: get_cdna_inputs(wildcards.sample),
        reference=REFERENCE_CHECK
    output:
        r1 = op.join(config['working_dir'], 'data', 'fastq', 'combined', '{sample}_R1.fastq.gz'),
        r2 = op.join(config['working_dir'], 'data', 'fastq', 'combined', '{sample}_R2.fastq.gz')
    params:
        outdir = op.join(config['working_dir'], 'data', 'fastq', 'combined')
    resources:
        mem_mb=512
    log:
        op.join(config['working_dir'], 'logs', '{sample}_concat_fastqs.log')
    shell:
        """
        mkdir -p {params.outdir}
        cat {input.r1} > {output.r1} 2> {log}
        cat {input.r2} > {output.r2} 2>> {log}
        """


rule downsample_fastqs:
    input:
        r1 = lambda wildcards: _raw_cbumi_path(wildcards.sample),
        r2 = lambda wildcards: _raw_cdna_path(wildcards.sample),
        reference=REFERENCE_CHECK
    output:
        r1 = op.join(config['working_dir'], 'data', 'fastq', 'downsampled', '{sample}_R1.fastq.gz'),
        r2 = op.join(config['working_dir'], 'data', 'fastq', 'downsampled', '{sample}_R2.fastq.gz')
    params:
        fraction = lambda wildcards: get_downsample_fraction(wildcards.sample),
        seed = config.get('downsample_seed', 42),
        outdir = op.join(config['working_dir'], 'data', 'fastq', 'downsampled')
    threads:
        min(4, workflow.cores)
    resources:
        mem_mb=1024
    log:
        op.join(config['working_dir'], 'logs', '{sample}_downsample.log')
    benchmark:
        op.join(config['working_dir'], 'benchmarks', '{sample}_downsample.txt')
    shell:
        """
        mkdir -p {params.outdir}
        seqtk sample -s {params.seed} {input.r1} {params.fraction} \
            | pigz -p {threads} > {output.r1} 2> {log}
        seqtk sample -s {params.seed} {input.r2} {params.fraction} \
            | pigz -p {threads} > {output.r2} 2>> {log}
        """


rule validate_bead_version:
    input:
        cb_umi = lambda wildcards: preparation_inputs(wildcards.sample, 1),
        reference=REFERENCE_CHECK
    output:
        flag = op.join(config['working_dir'], 'logs', '{sample}_bead_version_validated.flag'),
        qc_tsv = op.join(config['working_dir'], 'linker_qc', '{sample}_linker_errors.tsv')
    params:
        bead_type = lambda wildcards: get_bead_type_by_name(wildcards.sample),
        allowedlist = lambda wildcards: get_declared_allowedlist(wildcards.sample),
        diversity_insets = lambda wildcards: get_declared_diversity_insets(wildcards.sample),
        n_reads = config.get('bead_scan_n_reads', 10000)
    resources:
        mem_mb=256
    log:
        op.join(config['working_dir'], 'logs', '{sample}_bead_version_validation.log')
    run:
        import os as _os, sys

        stats = scan_r1_linkers(input.cb_umi, n_reads=params.n_reads)
        detected = stats['class']
        detected_insets = 'no' if detected == 'v1' else ('yes' if detected == 'enhanced' else 'unknown')

        lines = [
            f"reads scanned: {stats['n_reads']}",
            f"detected bead linker class: {detected}",
            f"detected diversity_insets: {detected_insets}",
            f"declared allowedlist: {params.allowedlist if params.allowedlist else '(default)'}",
            f"declared diversity_insets: {params.diversity_insets if params.diversity_insets else '(default)'}",
            f"derived internal bead type: {params.bead_type}",
            f"v1 exact-match fraction: {stats['v1_frac']:.4f}",
            f"enhanced exact-match fraction: {stats['enh_frac']:.4f}",
        ]
        if params.diversity_insets is not None and detected_insets != 'unknown' \
           and params.diversity_insets != detected_insets:
            lines.append(
                f"WARNING: declared diversity_insets '{params.diversity_insets}' does not match "
                f"detected '{detected_insets}'. Check the allowedlist/diversity_insets config."
            )

        with open(log[0], 'w') as fh:
            fh.write('\n'.join(lines) + '\n')
        for line in lines:
            print(line, file=sys.stderr)

        _os.makedirs(op.dirname(output.qc_tsv), exist_ok=True)
        with open(output.qc_tsv, 'w') as fh:
            fh.write(f"# sample\t{wildcards.sample}\n")
            fh.write(f"# detected_class\t{detected}\n")
            fh.write(f"# n_reads\t{stats['n_reads']}\n")
            fh.write('class\tn_errors\tn_reads\tfrac\n')
            for klass, hist in (('v1', stats['v1_errors']), ('enhanced', stats['enh_errors'])):
                for n_err in sorted(hist):
                    frac = hist[n_err] / stats['n_reads'] if stats['n_reads'] else 0.0
                    fh.write(f"{klass}\t{n_err}\t{hist[n_err]}\t{frac:.6f}\n")

        if detected != 'enhanced':
            raise ValueError('Expected Enhanced linkers before preparation; inspect bead validation log')
        with open(output.flag, 'w') as fh:
            fh.write(detected + '\n')


rule prepare_fastq_unit:
    input:
        r1=lambda wc: preparation_inputs(wc.sample, 1)[preparation_units(wc.sample).index(wc.unit)],
        r2=lambda wc: preparation_inputs(wc.sample, 2)[preparation_units(wc.sample).index(wc.unit)],
        chemistry=op.join(WORK, 'logs', '{sample}_bead_version_validated.flag'),
        scripts=[op.join(SCRIPTS, name) for name in ('prepare_reads.py', 'simpleaf_quant.py')]
    output:
        r1=temp(UNIT_R1), r2=temp(UNIT_R2), stats=UNIT_STATS
    params:
        script=op.join(SCRIPTS, 'prepare_reads.py'),
        max_errors=config.get('cb_umi_max_errors', 0)
    threads: config['nthreads']
    resources:
        mem_mb=config.get('preprocess_mem_mb', 8192)
    log:
        op.join(WORK, 'logs', '{sample}_unit_{unit}.log')
    benchmark:
        op.join(WORK, 'benchmarks', '{sample}_unit_{unit}.txt')
    message: 'Stream enhanced preparation for {wildcards.sample}, unit {wildcards.unit}'
    shell:
        'python3 {params.script:q} --r1 {input.r1:q} --r2 {input.r2:q} '
        '--output1 {output.r1:q} --output2 {output.r2:q} --report {output.stats:q} '
        '--log {log:q} --sample {wildcards.sample:q} --unit {wildcards.unit:q} '
        '--threads {threads} --max-errors {params.max_errors:q}'


rule standardize_cb_umis_cutadapt:
    input:
        r1=lambda wc: expand(UNIT_R1, sample=wc.sample, unit=preparation_units(wc.sample)),
        r2=lambda wc: expand(UNIT_R2, sample=wc.sample, unit=preparation_units(wc.sample)),
        stats=lambda wc: expand(UNIT_STATS, sample=wc.sample, unit=preparation_units(wc.sample)),
        raw1=lambda wc: preparation_inputs(wc.sample, 1),
        raw2=lambda wc: preparation_inputs(wc.sample, 2),
        scripts=[op.join(SCRIPTS, name) for name in ('prepare_reads.py', 'simpleaf_quant.py')]
    output:
        cdna=R2, standardized_cb_umi=R1,
        stats=op.join(WORK, 'logs', 'standardize_cb_umis_{sample}.json')
    params:
        units=lambda wc: preparation_units(wc.sample),
        downsampled=lambda wc: get_downsample_fraction(wc.sample) < 1.0
    resources:
        mem_mb=512
    message: 'Assemble prepared gzip streams in configured lane order for {wildcards.sample}'
    run:
        from prepare_reads import combine_prepared
        combine_prepared(input.r1, input.r2, input.stats, input.raw1, input.raw2,
                         output.standardized_cb_umi, output.cdna, output.stats,
                         wildcards.sample, params.units, params.downsampled)


rule derive_observed_whitelist:
    input:
        cb_umi_fq=R1, cdna=R2,
        raw1=lambda wc: get_cbumi_inputs(wc.sample),
        raw2=lambda wc: get_cdna_inputs(wc.sample),
        panels=expand(op.join(PANELS, 'BD_CLS{part}.txt'), part=[1,2,3]),
        stats=op.join(WORK, 'logs', 'standardize_cb_umis_{sample}.json'),
        script=op.join(SCRIPTS, 'simpleaf_quant.py')
    output:
        observed_whitelist=WHITELIST,
        receipt=op.join(WORK, '{sample}', 'qc', 'preparation_qc.json')
    params:
        downsampled=lambda wc: get_downsample_fraction(wc.sample) < 1.0
    threads: 1
    resources:
        mem_mb=config.get('fastq_qc_mem_mb', 4096)
    message: 'Validate prepared R1 and derive whitelist for {wildcards.sample}'
    log:
        op.join(WORK, 'logs', '{sample}_derive_observed_whitelist.log')
    benchmark:
        op.join(WORK, 'benchmarks', '{sample}_derive_observed_whitelist.txt')
    run:
        from simpleaf_quant import prepare_qc
        from contextlib import redirect_stdout
        with open(log[0], 'w') as handle, redirect_stdout(handle):
            prepare_qc(input.raw1, input.raw2, input.cb_umi_fq, input.cdna,
                       input.panels, output.observed_whitelist, input.stats,
                       output.receipt, wildcards.sample, params.downsampled)
